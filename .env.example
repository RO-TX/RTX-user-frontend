# Point the app at RTX-main-backend. Without this the screens fall back to
# the bundled placeholder data so the prototype still renders.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Firebase web config, for "Continue with Google". Copy from
# Firebase console → Project settings → Your apps. Leave these unset and the
# Google button is hidden — the password form is unaffected.
# These are not secrets; a Firebase web config is meant to ship in the client.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
